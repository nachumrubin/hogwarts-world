{
  "name": "hogwarts-world",
  "private": true,
  "version": "0.2.0",
  "description": "Hogwarts open world: WebGPU + WGSL + TypeScript, procedural terrain streaming, no engine",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node tools/build.mjs",
    "start": "node tools/build.mjs && node tools/serve.mjs",
    "test": "node --test \"tests/*.test.js\" \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "headless": "node tools/build.mjs && node tools/headless.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@webgpu/types": "^0.1.60",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
